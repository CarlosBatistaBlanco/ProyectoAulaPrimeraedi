<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_fondo">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarDirecciones"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/azul_oscuro"
        app:title="Direcciones de Entrega"
        app:titleTextColor="@color/white"
        app:navigationIcon="@android:drawable/ic_menu_revert" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#EFF6FF"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvContadorDirecciones"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Direcciones registradas: 0 / 15"
            android:textColor="@color/cian_primario"
            android:textStyle="bold"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNuevaDireccion"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="+ Nueva"
            android:textSize="11sp"
            app:cornerRadius="6dp"
            android:backgroundTint="@color/cian_primario" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDirecciones"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp"
        android:clipToPadding="false" />

</LinearLayout>
