<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_fondo">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarCarrito"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/azul_oscuro"
        app:title="Mi Carrito de Compras"
        app:titleTextColor="@color/white"
        app:navigationIcon="@android:drawable/ic_menu_revert" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCarrito"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/tvCarritoVacio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Tu carrito está vacío.\nExplora el catálogo y añade equipos."
        android:gravity="center"
        android:textColor="@color/texto_secundario"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- Card de Resumen de Pago y Checkout -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="10dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/card_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Dirección de Entrega Seleccionada -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dirección de Envío"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="@color/texto_principal" />

                <TextView
                    android:id="@+id/btnGestionarDirecciones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Gestionar direcciones"
                    android:textColor="@color/cian_primario"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:padding="4dp" />
            </LinearLayout>

            <Spinner
                android:id="@+id/spinnerDirecciones"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_search_input"
                android:layout_marginTop="4dp" />

            <!-- Método de Pago -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Método de Pago"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="@color/texto_principal"
                android:layout_marginTop="10dp" />

            <Spinner
                android:id="@+id/spinnerMetodoPago"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_search_input"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total a Pagar (IVA 19% inc.):"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvTotalCarrito"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0"
                    android:textColor="@color/azul_oscuro"
                    android:textStyle="bold"
                    android:textSize="18sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmarPedido"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Confirmar Pedido y Facturar"
                android:textStyle="bold"
                android:textSize="15sp"
                app:cornerRadius="10dp"
                android:backgroundTint="@color/cian_primario"
                android:layout_marginTop="14dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
