<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/borde_suave"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDirEtiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Casa / Principal"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/azul_oscuro" />

                <TextView
                    android:id="@+id/tvDirPredeterminada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PREDETERMINADA"
                    android:textSize="8sp"
                    android:textColor="#065F46"
                    android:background="#D1FAE5"
                    android:textStyle="bold"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginStart="8dp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDirDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cra 14 #32-15, Bocagrande, Cartagena"
                android:textSize="12sp"
                android:textColor="@color/texto_principal"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvDirTelefono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tel: 3001234567"
                android:textSize="11sp"
                android:textColor="@color/texto_secundario"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEliminarDireccion"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/naranja_alerta"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Eliminar dirección" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
