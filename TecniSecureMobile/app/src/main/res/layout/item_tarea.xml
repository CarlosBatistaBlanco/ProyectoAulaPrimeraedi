<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/borde_suave"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTareaPrioridad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALTA"
                android:textStyle="bold"
                android:textSize="9sp"
                android:textColor="@color/white"
                android:background="@color/naranja_alerta"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp" />

            <TextView
                android:id="@+id/tvTareaTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Instalación Kit 4 Cámaras IP"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/azul_oscuro"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/tvTareaEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDIENTE"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/cian_primario"
                android:background="@color/gris_badge"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTareaResponsable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Responsable: Técnico"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/cian_primario"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTareaDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configurar NVR, canaletas y visualización remota en app móvil del cliente."
            android:textSize="12sp"
            android:textColor="@color/texto_secundario"
            android:layout_marginTop="6dp" />

        <!-- Advertencia de Bloqueo / Estado de Revisión -->
        <TextView
            android:id="@+id/tvAvisoBloqueo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bloqueada: En revisión por el administrador. Solo lectura."
            android:textColor="#B91C1C"
            android:background="#FEE2E2"
            android:padding="8dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/borde_suave"
            android:layout_marginVertical="10dp" />

        <!-- Acciones: Actualizar progreso / Revisar / Ver historial -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEntregarTarea"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Entregar con Evidencia"
                android:textSize="11sp"
                app:cornerRadius="6dp"
                android:backgroundTint="@color/cian_primario"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHistorialTarea"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Historial"
                android:textSize="11sp"
                app:cornerRadius="6dp"
                android:backgroundTint="@color/azul_oscuro" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
