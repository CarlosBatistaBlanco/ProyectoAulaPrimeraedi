<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/borde_suave"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivItemCarritoFoto"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:background="@color/white"
            android:src="@android:drawable/ic_menu_gallery" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvItemCarritoNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cámara Domo IP"
                android:textColor="@color/texto_principal"
                android:textStyle="bold"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvItemCarritoPrecio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$185.000 c/u"
                android:textColor="@color/cian_primario"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Controles de Cantidad -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnMenosCantidad"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_search_input"
                android:src="@android:drawable/ic_delete"
                android:contentDescription="Restar" />

            <TextView
                android:id="@+id/tvCantidad"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:gravity="center"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/texto_principal" />

            <ImageButton
                android:id="@+id/btnMasCantidad"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_search_input"
                android:src="@android:drawable/ic_input_add"
                android:contentDescription="Sumar" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
