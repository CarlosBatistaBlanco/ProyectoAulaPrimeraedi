@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 10
skinparam roundCorner 4

' Estilo limpio para entidades
skinparam entity {
    BorderColor black
    BackgroundColor white
}

title MODELO ENTIDAD-RELACIÓN (MER) - TECNISERVICIOS (TECNISECURE)

' ==========================================
' MÓDULO DE USUARIOS Y SEGURIDAD
' ==========================================
entity "roles" as roles {
    * id : INT <<PK, generated>>
    --
    * nombre : VARCHAR(30) <<UNIQUE>>
}

entity "usuarios" as usuarios {
    * id : BIGINT <<PK, generated>>
    --
    * correo : VARCHAR(150) <<UNIQUE>>
    * password : VARCHAR(255)
    * nombre : VARCHAR(100)
    * apellido : VARCHAR(100)
    telefono : VARCHAR(20)
    * activo : BOOLEAN
    * rol_id : INT <<FK>>
    * creado_en : TIMESTAMP
}

entity "clientes" as clientes {
    * id : BIGINT <<PK, FK>>
    --
    documento_tipo : VARCHAR(10)
    documento_numero : VARCHAR(30) <<UNIQUE>>
    direccion : VARCHAR(255)
    ciudad : VARCHAR(100)
}

entity "empleados" as empleados {
    * id : BIGINT <<PK, FK>>
    --
    * cargo : VARCHAR(100)
    especialidad : VARCHAR(150)
    fecha_contratacion : DATE
}

entity "tokens_recuperacion" as tokens_recuperacion {
    * id : BIGINT <<PK, generated>>
    --
    * token : VARCHAR(100) <<UNIQUE>>
    * usuario_id : BIGINT <<FK>>
    * expira_en : TIMESTAMP
    * usado : BOOLEAN
}

entity "logs_actividad" as logs_actividad {
    * id : BIGINT <<PK, generated>>
    --
    usuario_id : BIGINT <<FK>>
    * accion : VARCHAR(100)
    detalles : TEXT
    ip_origen : VARCHAR(50)
    * creado_en : TIMESTAMP
}

' ==========================================
' MÓDULO DE CATÁLOGO E INVENTARIO
' ==========================================
entity "categorias" as categorias {
    * id : BIGINT <<PK, generated>>
    --
    * nombre : VARCHAR(100) <<UNIQUE>>
    descripcion : TEXT
    icono : VARCHAR(50)
    * activo : BOOLEAN
}

entity "marcas" as marcas {
    * id : BIGINT <<PK, generated>>
    --
    * nombre : VARCHAR(100) <<UNIQUE>>
    descripcion : TEXT
    logo_url : VARCHAR(255)
    * activo : BOOLEAN
}

entity "productos" as productos {
    * id : BIGINT <<PK, generated>>
    --
    * sku : VARCHAR(50) <<UNIQUE>>
    * nombre : VARCHAR(200)
    descripcion : TEXT
    * precio : DECIMAL(12,2)
    * descuento_porcentaje : INT
    * stock : INT
    * stock_minimo : INT
    * categoria_id : BIGINT <<FK>>
    * marca_id : BIGINT <<FK>>
    * destacado : BOOLEAN
    * activo : BOOLEAN
}

entity "producto_imagenes" as producto_imagenes {
    * id : BIGINT <<PK, generated>>
    --
    * producto_id : BIGINT <<FK>>
    * url : VARCHAR(255)
    * es_principal : BOOLEAN
    * orden : INT
}

entity "inventario_movimientos" as inventario_movimientos {
    * id : BIGINT <<PK, generated>>
    --
    * producto_id : BIGINT <<FK>>
    * tipo : VARCHAR(20)
    * cantidad : INT
    * stock_anterior : INT
    * stock_nuevo : INT
    motivo : VARCHAR(255)
    usuario_id : BIGINT <<FK>>
    * creado_en : TIMESTAMP
}

entity "favoritos" as favoritos {
    * cliente_id : BIGINT <<PK, FK>>
    * producto_id : BIGINT <<PK, FK>>
    --
    * creado_en : TIMESTAMP
}

' ==========================================
' MÓDULO DE PEDIDOS Y FACTURACIÓN
' ==========================================
entity "estados_pedido" as estados_pedido {
    * id : INT <<PK, generated>>
    --
    * codigo : VARCHAR(30) <<UNIQUE>>
    * nombre : VARCHAR(50)
}

entity "pedidos" as pedidos {
    * id : BIGINT <<PK, generated>>
    --
    * numero_pedido : VARCHAR(30) <<UNIQUE>>
    * cliente_id : BIGINT <<FK>>
    * estado_id : INT <<FK>>
    * subtotal : DECIMAL(12,2)
    * descuento_total : DECIMAL(12,2)
    * impuestos : DECIMAL(12,2)
    * total : DECIMAL(12,2)
    * direccion_envio : VARCHAR(255)
    * telefono_contacto : VARCHAR(30)
    * creado_en : TIMESTAMP
}

entity "pedido_detalle" as pedido_detalle {
    * id : BIGINT <<PK, generated>>
    --
    * pedido_id : BIGINT <<FK>>
    * producto_id : BIGINT <<FK>>
    * cantidad : INT
    * precio_unitario : DECIMAL(12,2)
    * descuento_unitario : DECIMAL(12,2)
    * subtotal : DECIMAL(12,2)
}

entity "pedidos_historial" as pedidos_historial {
    * id : BIGINT <<PK, generated>>
    --
    * pedido_id : BIGINT <<FK>>
    * estado_id : INT <<FK>>
    observacion : VARCHAR(255)
    cambiado_por : BIGINT <<FK>>
    * creado_en : TIMESTAMP
}

entity "facturas" as facturas {
    * id : BIGINT <<PK, generated>>
    --
    * numero_factura : VARCHAR(50) <<UNIQUE>>
    * pedido_id : BIGINT <<FK, UNIQUE>>
    * monto_total : DECIMAL(12,2)
    * metodo_pago : VARCHAR(50)
    * fecha_emision : TIMESTAMP
}

' ==========================================
' MÓDULO DE SERVICIOS TÉCNICOS Y CHAT
' ==========================================
entity "servicios" as servicios {
    * id : BIGINT <<PK, generated>>
    --
    * nombre : VARCHAR(150) <<UNIQUE>>
    descripcion : TEXT
    * precio_base : DECIMAL(12,2)
    * activo : BOOLEAN
}

entity "solicitudes_servicio" as solicitudes_servicio {
    * id : BIGINT <<PK, generated>>
    --
    * cliente_id : BIGINT <<FK>>
    * servicio_id : BIGINT <<FK>>
    empleado_id : BIGINT <<FK>>
    * estado : VARCHAR(30)
    * direccion : VARCHAR(255)
    descripcion_falla : TEXT
    * fecha_solicitud : TIMESTAMP
}

entity "mensajes_chat" as mensajes_chat {
    * id : BIGINT <<PK, generated>>
    --
    * cliente_id : BIGINT <<FK>>
    empleado_id : BIGINT <<FK>>
    * enviado_por : VARCHAR(20)
    * contenido : TEXT
    * leido : BOOLEAN
    * creado_en : TIMESTAMP
}

entity "resenas" as resenas {
    * id : BIGINT <<PK, generated>>
    --
    * cliente_id : BIGINT <<FK>>
    * producto_id : BIGINT <<FK>>
    * calificacion : INT
    comentario : TEXT
    * creado_en : TIMESTAMP
}

' ==========================================
' RELACIONES ENTRE ENTIDADES
' ==========================================
roles ||--o{ usuarios : "asigna rol a"
usuarios ||--o| clientes : "perfil cliente"
usuarios ||--o| empleados : "perfil técnico"
usuarios ||--o{ tokens_recuperacion : "solicita"
usuarios ||--o{ logs_actividad : "genera registro"

categorias ||--o{ productos : "clasifica"
marcas ||--o{ productos : "fabrica"
productos ||--o{ producto_imagenes : "contiene"
productos ||--o{ inventario_movimientos : "registra stock"
usuarios ||--o{ inventario_movimientos : "responsable"
productos ||--o{ resenas : "recibe"

clientes ||--o{ favoritos : "guarda"
productos ||--o{ favoritos : "incluido en"

clientes ||--o{ pedidos : "realiza"
estados_pedido ||--o{ pedidos : "estado actual"
pedidos ||--o{ pedido_detalle : "desglosa líneas"
productos ||--o{ pedido_detalle : "ítem comprado"
pedidos ||--o{ pedidos_historial : "trazabilidad"
estados_pedido ||--o{ pedidos_historial : "estado histórico"
usuarios ||--o{ pedidos_historial : "cambiado por"
pedidos ||--o| facturas : "factura generada"

clientes ||--o{ solicitudes_servicio : "solicita"
servicios ||--o{ solicitudes_servicio : "tipo de servicio"
empleados ||--o{ solicitudes_servicio : "asignado a"

clientes ||--o{ mensajes_chat : "emisor cliente"
empleados ||--o{ mensajes_chat : "atendido por"

clientes ||--o{ resenas : "opina"

@enduml
