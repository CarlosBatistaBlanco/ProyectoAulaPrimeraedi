# ---------------------------------------------------------------------
# Plantilla de configuracion para Docker
# Copia este archivo como ".env" y completa los valores reales.
#   cp .env.ejemplo .env
# El archivo .env NO se sube al repositorio (contiene datos sensibles).
# ---------------------------------------------------------------------

# Clave de la API de DeepSeek (asistente virtual del sitio publico).
# Se obtiene en https://platform.deepseek.com/api_keys
# Si se deja vacia, el asistente responde solo con el catalogo y las
# preguntas frecuentes, y escala al equipo cuando no sabe algo.
DEEPSEEK_API_KEY=
DEEPSEEK_MODELO=deepseek-chat

# Cuenta de correo para enviar notificaciones (opcional).
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Puerto publicado en el equipo anfitrion (http://localhost:PUERTO)
PUERTO=8080
